<resources>
    <style name="AniTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowAnimationStyle">@style/AniPageAnimation</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#1C1C20</item>
        <item name="android:colorAccent">#EB7199</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
    </style>
    <style name="AniPageAnimation">
        <item name="android:activityOpenEnterAnimation">@anim/page_in</item><item name="android:activityOpenExitAnimation">@anim/page_out</item>
        <item name="android:activityCloseEnterAnimation">@anim/page_out</item><item name="android:activityCloseExitAnimation">@anim/close_out</item>
    </style>
    <style name="AniDrawerAnimation"><item name="android:windowEnterAnimation">@anim/drawer_in</item><item name="android:windowExitAnimation">@anim/drawer_out</item></style>
    <style name="AniDialogAnimation"><item name="android:windowEnterAnimation">@anim/dialog_in</item><item name="android:windowExitAnimation">@anim/dialog_out</item></style>
    <style name="AniPlayerTheme" parent="AniTheme"><item name="android:windowAnimationStyle">@null</item></style>
</resources>
